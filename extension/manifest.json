{
  "manifest_version": 3,
  "name": "Resell Lister",
  "version": "1.0.0",
  "description": "Fills eBay, Poshmark and Vinted sell forms with listings written in the Resell Lister app.",
  "permissions": ["storage", "unlimitedStorage"],
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Resell Lister" },
  "content_scripts": [
    {
      "matches": ["https://*.github.io/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ebay.com/*", "https://poshmark.com/*", "https://www.vinted.com/*"],
      "js": ["filler.js"],
      "run_at": "document_idle"
    }
  ]
}
